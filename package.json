{
  "name": "opendynamics",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:cf": "NITRO_PRESET=cloudflare-pages nuxt build",
    "dev": "nuxt dev --dotenv .env.local",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:cf": "wrangler pages dev dist",
    "postinstall": "nuxt prepare",
    "start": "bun run .output/server/index.mjs",
    "deploy": "bun run build:cf && wrangler pages deploy dist",
    "deploy:prod": "bun run build:cf && wrangler pages deploy dist --branch main",
    "convex:dev": "bunx convex dev",
    "convex:deploy": "bunx convex deploy",
    "convex:seed": "bunx convex run seedAdmin:seed",
    "convex:run": "bunx convex run",
    "convex:gen-key": "docker compose exec convex-backend ./generate_admin_key.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/vue-3": "^3.20.0",
    "@vueuse/core": "^14.2.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.7",
    "dompurify": "^3.3.1",
    "jose": "^6.1.3",
    "lucide-vue-next": "^0.563.0",
    "nuxt": "^3.21.0",
    "pinia": "^3.0.4",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.27",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^3.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.1.0",
    "@vite-pwa/nuxt": "^1.1.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "workbox-window": "^7.4.0",
    "wrangler": "^4.61.1"
  }
}
