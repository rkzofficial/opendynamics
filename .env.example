# ===========================================
# App Configuration (required at runtime)
# ===========================================
NUXT_CONVEX_URL=https://your-project.convex.cloud
SESSION_SECRET=your-session-secret-min-32-chars-here!!
ENCRYPTION_KEY=exactly-32-characters-key-here!!
NUXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Convex CLI only (for local development)
# ===========================================
# Used by `npx convex dev` - not needed by the app itself
CONVEX_DEPLOYMENT=dev:your-project-name

# ===========================================
# Notes
# ===========================================
# - OIDC and Dynamics settings are configured via Admin Settings UI
#   (stored encrypted in Convex database)
# - After deploying Convex schema, run: bunx convex run seedAdmin:seed
# - Default admin credentials: admin / admin (change after first login!)
