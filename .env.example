# ===========================================
# Docker Compose Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# ===========================================
# Domain Configuration
# ===========================================
APP_DOMAIN=opendynamics.kira.yt

# ===========================================
# Convex Self-Hosted Configuration
# ===========================================
# Full URL to your self-hosted Convex backend (used by docker-compose)
CONVEX_SELF_HOSTED_URL=https://convex.vm.kira.yt

# Direct Convex URL for local development (without docker-compose)
# NUXT_PUBLIC_CONVEX_URL=https://convex.vm.kira.yt

# Admin key - Generate AFTER starting containers with:
# docker compose exec convex-backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ===========================================
# App Security Keys (required)
# ===========================================
# Session Secret (min 32 characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret_min_32_chars_here

# Encryption Key (exactly 32 characters)
# Generate with: openssl rand -base64 24
ENCRYPTION_KEY=exactly-32-characters-key-here!!

# ===========================================
# Optional: PWA Push Notifications
# ===========================================
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
