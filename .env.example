# Convex Configuration
CONVEX_DEPLOYMENT=dev:your-project-name
NUXT_CONVEX_URL=https://your-project.convex.cloud

# Session & Encryption (use strong random strings in production)
SESSION_SECRET=your-session-secret-min-32-chars-here!!
ENCRYPTION_KEY=your-encryption-key-for-tokens-32chars!

# App URL
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Note: OIDC and Dynamics settings are configured via Admin Settings UI
# They are stored encrypted in Convex database

# Cloudflare Pages Deployment
# Set these environment variables in the Cloudflare Dashboard:
# Settings > Environment Variables
# - NUXT_CONVEX_URL
# - SESSION_SECRET
# - ENCRYPTION_KEY
# - NUXT_PUBLIC_APP_URL (set to your production domain)

# Initial Admin Setup
# After deploying Convex schema, run: bunx convex run seedAdmin:seed
# Default credentials: admin / admin
# IMPORTANT: Change the password after first login!
